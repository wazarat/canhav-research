# ================================================================
# Supabase (active "eth-data" project used by /api/companies)
# Create at https://supabase.com/dashboard -> Project Settings -> API
# ================================================================
NEW_NEXT_PUBLIC_SUPABASE_URL=https://YOUR-NEW-PROJECT-REF.supabase.co
NEW_NEXT_PUBLIC_SUPABASE_ANON_KEY=your-new-project-anon-key
NEW_SUPABASE_SERVICE_ROLE_KEY=your-new-project-service-role-key

# ================================================================
# Browser-side Supabase (Next.js only exposes NEXT_PUBLIC_* to the client).
# Required for Supabase Realtime subscriptions so the market map
# auto-refreshes when rows change in the DB. Duplicates the "NEW_"
# values above but with a browser-visible prefix.
# ================================================================
NEXT_PUBLIC_ETHDATA_SUPABASE_URL=https://YOUR-NEW-PROJECT-REF.supabase.co
NEXT_PUBLIC_ETHDATA_SUPABASE_ANON_KEY=your-new-project-anon-key

# ================================================================
# Legacy Supabase (kept for the older `companies` table + submit forms)
# ================================================================
NEXT_PUBLIC_SUPABASE_URL=https://egesqobnveubddfpzrkp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-key

# ================================================================
# Supabase MCP (used by Cursor, NOT the Next.js app)
# Create at https://supabase.com/dashboard/account/tokens
# Needs to be exported in the shell Cursor launches from,
# OR placed in ~/.cursor/mcp.env / set inline in .cursor/mcp.json
# ================================================================
SUPABASE_ACCESS_TOKEN=sbp_your_personal_access_token_here

# ================================================================
# Supabase Management API (used by the /admin/subsector-ingest
# pipeline to run DDL — CREATE/ALTER TABLE for per-subsector tables).
# The PAT is the same kind as SUPABASE_ACCESS_TOKEN; the PROJECT_REF
# is the slug that appears in your Supabase URL (https://<ref>.supabase.co).
# ================================================================
SUPABASE_MANAGEMENT_PAT=sbp_your_personal_access_token_here
SUPABASE_PROJECT_REF=ekezgvoburmfjmkdzjhq

# ================================================================
# /admin/* editorial tools — authentication
#
# Admin access is now backed by Supabase Auth + public.admin_users.
# There is no shared ADMIN_AUTH_TOKEN. Instead:
#   1. Enable Google in the Supabase dashboard (eth-data project) —
#      Email magic-link is on by default for Outlook/Hotmail/other.
#   2. Whitelist http://localhost:3000/api/auth/callback and
#      https://www.canhav.com/api/auth/callback under Authentication ->
#      URL Configuration -> Redirect URLs.
#   3. Seed your first super-admin (run ADMIN_AUTH_SETUP.md's seed SQL).
#
# NEXT_PUBLIC_SITE_URL is optional — used by the /api/admin/members
# invite endpoint to construct the OAuth callback URL when it can't
# figure it out from the request headers (e.g. background jobs).
# ================================================================
# NEXT_PUBLIC_SITE_URL=https://www.canhav.com

# ================================================================
# Vercel API (used by scripts/vercel-logs.mjs for deploy triage)
# Create at https://vercel.com/account/tokens
# VERCEL_PROJECT_ID can be the slug (e.g. canhav-research) or prj_*.
# VERCEL_TEAM_ID is only needed if the project lives under a team.
# ================================================================
VERCEL_TOKEN=your_vercel_personal_token_here
VERCEL_PROJECT_ID=canhav-research
# VERCEL_TEAM_ID=team_xxx

# ================================================================
# EmailJS (contact forms)
# ================================================================
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_emailjs_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
